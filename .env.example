# Copy to .env (never commit the real file). The app reads it automatically at start-up.
# Get a key at https://aistudio.google.com/apikey. Without a key the app still runs and shows labelled demo suggestions.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
